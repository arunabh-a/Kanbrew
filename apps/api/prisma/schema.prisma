generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ───────────── CORE ─────────────
model User {
    id        String  @id @default(uuid()) @db.Uuid // = auth.users.id
    email     String  @unique
    name      String?
    username  String? @unique // optional handle
    avatarUrl String?

    // lifecycle
    status                UserStatus @default(ACTIVE)
    emailVerifiedAt       DateTime?
    onboardingCompletedAt DateTime?
    lastLoginAt           DateTime?
    createdAt             DateTime   @default(now())
    updatedAt             DateTime   @updatedAt
    deletedAt             DateTime? // soft delete

    // preferences
    locale   String @default("en")
    timezone String @default("UTC")

    // ───────── OPTIONAL: add per app ─────────
    role     Role  @default(USER) // simple RBAC
    metadata Json? // escape hatch for app-specific fields

    // relations (specialize here)
    accounts           Account[]
    profile            Profile?
    sessions           Sessions[]
    verificationTokens VerificationToken[]
    // memberships         Membership[]

    //   App Data

    tasks         Task[]          @relation("CreatedTasks")
    assignedTasks Task[]          @relation("AssignedTasks")
    ownedProjects Project[]       @relation("OwnedProjects")
    memberships   ProjectMember[]

    @@index([status])
    @@index([deletedAt])
}

// ───────────── MODULE: linked login providers ─────────────
model Account {
    id             String   @id @default(uuid()) @db.Uuid
    userId         String   @db.Uuid
    hashedPassword String?
    provider       String // google | github | email
    providerUserId String
    createdAt      DateTime @default(now())
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerUserId])
}

// ───────────── MODULE: verification & one-time tokens ─────────────
model VerificationToken {
    id        String           @id @default(uuid()) @db.Uuid
    userId    String           @db.Uuid
    tokenHash String           @unique
    type      VerificationType @default(EMAIL_VERIFICATION)
    expiresAt DateTime
    createdAt DateTime         @default(now())
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, type])
}

// ───────────── MODULE: extended profile (keep User lean) ─────────────
model Profile {
    userId   String  @id @db.Uuid
    bio      String?
    website  String?
    company  String?
    jobTitle String?
    country  String?
    user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth User Session  Schema
model Sessions {
    id               String   @id @default(uuid()) @db.Uuid
    userId           String   @db.Uuid
    user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    refreshTokenHash String
    device           Json?
    createdAt        DateTime @default(now())
    expiresAt        DateTime
    revoked          Boolean  @default(false)
    ip               String?
    userAgent        String?

    @@index([userId])
}

// Product Schemas

model Task {
    id          String     @id @default(uuid()) @db.Uuid
    title       String
    description String?
    dueDate     DateTime?
    priority    Priority   @default(LOW)
    status      TaskStatus @default(TODO)
    user        User       @relation("CreatedTasks", fields: [userId], references: [id], onDelete: Cascade)
    userId      String     @db.Uuid
    assignee    User?      @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
    assigneeId  String?    @db.Uuid
    project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
    projectId   String?    @db.Uuid
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@index([userId])
    @@index([assigneeId])
    @@index([projectId])
    @@index([status])
    @@index([priority])
}

model Project {
    id          String          @id @default(uuid()) @db.Uuid
    name        String
    description String?
    ownerId     String          @db.Uuid
    owner       User            @relation("OwnedProjects", fields: [ownerId], references: [id])
    members     ProjectMember[]
    tasks       Task[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    @@index([ownerId])
}

model ProjectMember {
    id        String     @id @default(uuid()) @db.Uuid
    projectId String     @db.Uuid
    userId    String     @db.Uuid
    role      MemberRole @default(MEMBER)
    joinedAt  DateTime   @default(now())
    project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([userId])
}

enum UserStatus {
    ACTIVE
    SUSPENDED
    DELETED
}

enum Role {
    USER
    ADMIN
}

enum MemberRole {
    ADMIN
    MEMBER
}

enum Priority {
    LOW
    MEDIUM
    HIGH
}

enum TaskStatus {
    TODO
    IN_PROGRESS
    DONE
}

enum VerificationType {
    EMAIL_VERIFICATION
    PASSWORD_RESET
}
